---
import OrthoLayout from "../layouts/OrthoLayout.astro";
---

<OrthoLayout title="Home" subtitle="Lobby">
  <div
    class="relative w-full h-full pt-48 flex items-start justify-center overflow-hidden bg-slate-50 dark:bg-slate-900 transition-colors duration-700"
  >
    <div
      class="relative z-10 grid grid-cols-1max-w-5xl w-full px-12 gap-12 items-center"
    >
