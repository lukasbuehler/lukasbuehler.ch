---
import GardenLayout from "../layouts/GardenLayout.astro";
import EntryList from "../components/EntryList.astro";
import { publishedEntries, entryUrl } from "../lib/entries";
const entries = await publishedEntries();
const projects = entries
  .filter((e) => e.data.kind === "project" && e.data.featured !== undefined)
  .slice(0, 2);
const notes = entries
  .filter((e) => e.data.kind === "note" && e.data.featured !== undefined)
  .slice(0, 3);
const visual = projects.find((e) => e.data.image);
---

<GardenLayout description="The digital garden of Lukas Bühler. Software, robotics, parkour, and notes from work in progress.">
  <section class="home-intro" aria-labelledby="intro-title">
    <p class="eyebrow">Digital garden</p>
    <h1 id="intro-title">
      Lukas
      <br />
      Bühler
    </h1>
    <div class="intro-copy">
      <p>I build software and robots.</p>
      <p class="secondary">
        Projects, open questions, and things
        <br class="desktop-break" /> worth coming back to.
      </p>
      <a class="text-link" href="/about/">
        A little about me
      </a>
    </div>
  </section>
  {visual?.data.image && (
    <figure class="featured-visual">
      <a href={entryUrl(visual)}>
        <img
          src={visual.data.image.src}
          alt={visual.data.image.alt}
          fetchpriority="high"
        />
      </a>
      <figcaption>{visual.data.image.caption ?? visual.data.title}</figcaption>
    </figure>
  )}
  <section
    class="home-section projects-section"
    aria-labelledby="projects-title"
  >
    <div class="section-heading">
      <h2 id="projects-title">Selected projects</h2>
      <a class="text-link" href="/projects/">
        All projects
      </a>
    </div>
    <EntryList entries={projects} projects />
  </section>
  <section class="home-section notes-section" aria-labelledby="notes-title">
    <div class="section-heading">
      <h2 id="notes-title">Notes</h2>
      <a class="text-link" href="/notes/">
        All notes
      </a>
    </div>
    <EntryList entries={notes} />
  </section>
</GardenLayout>
