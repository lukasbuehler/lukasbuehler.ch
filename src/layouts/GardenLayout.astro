---
import "../styles/global.css";
import { pageSharingImage } from "../lib/sharing-pages";
import themeScript from "../scripts/theme.js?raw";
import { structuredData } from "../lib/structured-data";
import type { Entry } from "../lib/entries";
interface Props {
  title?: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  entry?: Entry;
  entries?: Entry[];
}
const {
  title,
  description,
  image,
  imageAlt,
  article = false,
  published,
  updated,
} = Astro.props;
const pageTitle = title
  ? `${title} — Lukas Bühler`
  : "Lukas Bühler — Digital garden";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const pageCard = pageSharingImage(Astro.url.pathname);
const imagePath = image ?? pageCard?.src;
const socialImage =
  imagePath && Astro.site ? new URL(imagePath, Astro.site) : undefined;
const path = Astro.url.pathname;
const navigation = [
  { href: "/projects/", label: "Projects" },
  { href: "/notes/", label: "Notes" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f6f0" />
    <script is:inline set:html={themeScript}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredData({
          canonical,
          title: title ?? pageTitle,
          description,
          image: socialImage,
          entry: Astro.props.entry,
          entries: Astro.props.entries,
        })}
      ></script>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && published && (
      <meta
        property="article:published_time"
        content={published.toISOString()}
      />
    )}
    {article && updated && (
      <meta property="article:modified_time" content={updated.toISOString()} />
    )}
    <meta property="og:site_name" content="Lukas Bühler" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta
          property="og:image:alt"
          content={imageAlt ?? pageCard?.alt ?? pageTitle}
        />
        <meta name="twitter:image" content={socialImage} />
        <meta
          name="twitter:image:alt"
          content={imageAlt ?? pageCard?.alt ?? pageTitle}
        />
      </>
    )}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Lukas Bühler, home">
          Lukas Bühler
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(({ href, label }) => (
            <a
              href={href}
              aria-current={
                path.startsWith(href.slice(0, -1)) ? "page" : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <a href="/">Lukas Bühler</a>
        <p>A personal digital garden.</p>
        <div class="footer-links">
          <a href="/about/">About this garden</a>
          <a href="/privacy/">Privacy</a>
          <label class="theme-control" data-theme-control hidden>
            Theme
            <select id="theme-preference" aria-label="Colour theme">
              <option value="system">System</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
        </div>
      </footer>
    </div>
    <script>
      import "../scripts/analytics";
      import "../scripts/external-links";
    </script>
  </body>
</html>
