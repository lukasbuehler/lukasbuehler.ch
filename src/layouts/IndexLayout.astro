---
import GardenLayout from "./GardenLayout.astro";
import EntryList from "../components/EntryList.astro";
import { publishedEntries, projectGroups } from "../lib/entries";
interface Props {
  kind: "note" | "project";
  title: string;
  description: string;
}
const { kind, title, description } = Astro.props;
const entries = (await publishedEntries()).filter((e) => e.data.kind === kind);
if (kind === "note")
  entries.sort(
    (a, b) => b.data.published!.getTime() - a.data.published!.getTime(),
  );
---

<GardenLayout title={title} description={description} entries={entries}>
  <header class="page-intro">
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  {kind === "project" ? (
    projectGroups.map((group) => {
      const projects = entries.filter(
        (entry) => entry.data.projectGroup === group.id,
      );
      return (
        projects.length > 0 && (
          <section
            id={group.id}
            class="home-section"
            aria-labelledby={`${group.id}-title`}
          >
            <div class="section-heading">
              <h2 id={`${group.id}-title`}>{group.title}</h2>
            </div>
            <EntryList entries={projects} projects />
          </section>
        )
      );
    })
  ) : (
    <section class="index-entries" aria-label={title}>
      <EntryList entries={entries} headingLevel="h2" />
    </section>
  )}
</GardenLayout>
