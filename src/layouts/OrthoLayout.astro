---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro"; // We'll extract nav too

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {subtitle}</title>
    <ClientRouter />
  </head>
  <body
    class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans transition-colors duration-700"
  >
    <Navbar title={title} subtitle={subtitle} />

    <main class="w-full h-screen overflow-hidden relative mobile-scroll">
      <slot />
    </main>

    <style is:global>
      /* --- MOBILE OVERRIDES --- */
      /* On small screens, disable the hidden overflow so we can scroll vertically */
      @media (max-width: 768px) {
        .mobile-scroll {
          height: auto !important;
          min-height: 100vh;
          overflow-y: auto !important;
          overflow-x: hidden;
        }
      }

      /* --- VIEW TRANSITIONS --- */
      /* These animations create the "sliding wall" effect */

      /* Camera moves RIGHT (Content slides out to left, new comes from right) */
      .slide-right::view-transition-old(root) {
        animation: 0.5s ease-in-out both slideOutLeft;
      }
      .slide-right::view-transition-new(root) {
        animation: 0.5s ease-in-out both slideInRight;
      }

      /* Camera moves LEFT (Content slides out to right, new comes from left) */
      .slide-left::view-transition-old(root) {
        animation: 0.5s ease-in-out both slideOutRight;
      }
      .slide-left::view-transition-new(root) {
        animation: 0.5s ease-in-out both slideInLeft;
      }

      @keyframes slideOutLeft {
        to {
          transform: translateX(-100%);
          opacity: 0.5;
        }
      }
      @keyframes slideOutRight {
        to {
          transform: translateX(100%);
          opacity: 0.5;
        }
      }
      @keyframes slideInLeft {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(0);
        }
      }
      @keyframes slideInRight {
        from {
          transform: translateX(100%);
        }
        to {
          transform: translateX(0);
        }
      }
    </style>

    <script>
      import {
        getNextRoom,
        getSlideAnimation,
      } from "../scripts/spatial-router";

      // State
      let lastScrollTime = 0;
      const SCROLL_DELAY = 800; // Slower delay for cleaner distinct movements

      // 1. Handle Wheel (Desktop Navigation)
      window.addEventListener(
        "wheel",
        (e) => {
          // Ignore if on mobile (screen width < 768px)
          if (window.innerWidth < 768) return;

          const now = Date.now();
          if (now - lastScrollTime < SCROLL_DELAY) return;

          // Threshold: Don't trigger on tiny accidental scrolls
          if (Math.abs(e.deltaY) < 30) return;

          lastScrollTime = now;
          const direction = e.deltaY > 0 ? "next" : "prev";
          const currentPath = window.location.pathname;
          const nextPath = getNextRoom(currentPath, direction);

          // Navigate
          if (nextPath !== currentPath) {
            window.location.href = nextPath;
          }
        },
        { passive: true }
      );

      // 2. Handle Transition Direction (The "Efficient Route" Visuals)
      document.addEventListener("astro:before-preparation", (e) => {
        const fromPath = window.location.pathname;
        const toPath = e.to.pathname;

        // Calculate which way we should visually slide
        const animationClass = getSlideAnimation(fromPath, toPath);

        // Apply class for CSS to pick up
        if (animationClass === "slide-right") {
          document.documentElement.classList.add("slide-right");
          document.documentElement.classList.remove("slide-left");
        } else {
          document.documentElement.classList.add("slide-left");
          document.documentElement.classList.remove("slide-right");
        }
      });

      // Cleanup
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.remove("slide-left", "slide-right");
      });
    </script>
  </body>
</html>
