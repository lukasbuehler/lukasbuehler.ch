---
import "katex/dist/katex.min.css";
import GardenLayout from "./GardenLayout.astro";
import EntryList from "../components/EntryList.astro";
import EntryDate from "../components/EntryDate.astro";
import { backlinks, type Entry } from "../lib/entries";
interface Props {
  entry: Entry;
  entries: Entry[];
}
const { entry, entries } = Astro.props;
const { data } = entry;
const mentions = backlinks(entry, entries);
const parent = data.kind === "project" ? "projects" : "notes";
---

<GardenLayout
  title={data.title}
  description={data.description}
  image={data.image?.src}
  article
  published={data.published}
  updated={data.updated}
>
  <article>
    <div
      class:list={[
        "article-intro",
        { "article-intro-with-image": data.kind === "project" && !!data.image },
      ]}
    >
      <header class="article-header">
        <a class="text-link breadcrumb" href={`/${parent}/`}>
          {data.kind === "project" ? "Projects" : "Notes"}{" "}
          <span aria-hidden="true">/</span>
        </a>
        <h1>{data.title}</h1>
        <p class="article-description">{data.description}</p>
      </header>
      {data.image && (
        <figure class="featured-visual">
          <img src={data.image.src} alt={data.image.alt} />
          <figcaption>{data.image.caption}</figcaption>
        </figure>
      )}
    </div>
    <div class="article-grid">
      <aside class="article-meta" aria-label="Page details">
        {data.published && (
          <div>
            <p class="meta-label">Published</p>
            <EntryDate date={data.published} />
          </div>
        )}
        {data.topics.length > 0 && (
          <div>
            <p class="meta-label">Topics</p>
            <p>{data.topics.join(" / ")}</p>
          </div>
        )}
        {data.status && (
          <div>
            <p class="meta-label">Status</p>
            <p>{data.status}</p>
          </div>
        )}
        {data.updated && (
          <div>
            <p class="meta-label">Updated</p>
            <EntryDate date={data.updated} />
          </div>
        )}
        {data.links.length > 0 && (
          <div class="project-links">
            {data.links.map((link) => (
              <a class="text-link" href={link.url}>
                {link.label}
              </a>
            ))}
          </div>
        )}
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
  {mentions.length > 0 && (
    <section
      class="home-section related-section"
      aria-labelledby="related-title"
    >
      <div class="section-heading">
        <h2 id="related-title">Linked from</h2>
      </div>
      <EntryList entries={mentions} />
    </section>
  )}
</GardenLayout>
