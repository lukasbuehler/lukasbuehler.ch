---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="featured-visual">
  <aviz-model>
    <div class="model-stage">
      <img src={src} alt={alt} width="1200" height="800" />
      <div class="model-canvas" hidden></div>
    </div>
    <div class="model-controls">
      <button type="button" data-load>
        Explore in 3D
      </button>
      <div data-controls hidden>
        <button type="button" data-zoom-in aria-label="Zoom in">
          +
        </button>
        <button type="button" data-zoom-out aria-label="Zoom out">
          −
        </button>
        <label>
          Tilt{" "}
          <input
            type="range"
            min="-45"
            max="45"
            value="0"
            step="1"
            aria-label="Motor tilt in degrees"
          />
        </label>
        <output>0°</output>
        <button type="button" data-reset>
          Reset
        </button>
        <button type="button" data-close>
          Still image
        </button>
      </div>
    </div>
    <p class="model-message" role="status"></p>
  </aviz-model>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
  class AvizModel extends HTMLElement {
    connectedCallback() {
      const load = this.querySelector<HTMLButtonElement>("[data-load]")!;
      const canvas = this.querySelector<HTMLElement>(".model-canvas")!;
      const image = this.querySelector("img")!;
      const controls = this.querySelector<HTMLElement>("[data-controls]")!;
      const message = this.querySelector<HTMLElement>("[role=status]")!;
      const range = this.querySelector("input")!;
      const output = this.querySelector("output")!;
      let viewer:
        | Awaited<
            ReturnType<typeof import("../../lib/aviz/viewer").mountViewer>
          >
        | undefined;
      const stop = () => {
        viewer?.dispose();
        viewer = undefined;
        canvas.hidden = true;
        image.hidden = false;
        controls.hidden = true;
        load.hidden = false;
        range.value = "0";
        output.value = "0°";
        message.textContent = "";
      };
      this.cleanup = stop;
      load.onclick = async () => {
        load.disabled = true;
        message.textContent = "Loading 3D model…";
        try {
          const { mountViewer } = await import("../../lib/aviz/viewer");
          canvas.hidden = false;
          viewer = await mountViewer(canvas);
          if (!this.isConnected) {
            stop();
            return;
          }
          image.hidden = true;
          load.hidden = true;
          controls.hidden = false;
          message.textContent =
            "Drag or focus the model and use arrow keys to rotate. Tilt previews joint motion, not flight behaviour.";
          this.querySelector<HTMLButtonElement>("[data-zoom-in]")!.focus();
        } catch {
          stop();
          load.textContent = "Retry 3D view";
          message.textContent =
            "The 3D view could not load. The still image remains available.";
        } finally {
          load.disabled = false;
        }
      };
      range.oninput = () => {
        viewer?.tilt(Number(range.value));
        output.value = `${range.value}°`;
      };
      this.querySelector<HTMLButtonElement>("[data-zoom-in]")!.onclick = () =>
        viewer?.zoom(0.85);
      this.querySelector<HTMLButtonElement>("[data-zoom-out]")!.onclick = () =>
        viewer?.zoom(1.15);
      this.querySelector<HTMLButtonElement>("[data-reset]")!.onclick = () => {
        viewer?.reset();
        viewer?.tilt(0);
        range.value = "0";
        output.value = "0°";
      };
      this.querySelector<HTMLButtonElement>("[data-close]")!.onclick = () => {
        stop();
        load.focus();
      };
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("aviz-model"))
    customElements.define("aviz-model", AvizModel);
</script>
<style>
  aviz-model {
    display: block;
  }
  .model-stage {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--wash);
  }
  .model-stage img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .model-canvas {
    position: absolute;
    inset: 0;
  }
  .model-canvas :global(canvas) {
    display: block;
    max-width: 100%;
  }
  .model-controls,
  [data-controls] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .model-controls {
    margin-top: 14px;
  }
  [hidden] {
    display: none !important;
  }
  button {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule);
    padding: 8px 12px;
    cursor: pointer;
  }
  button:disabled {
    cursor: wait;
  }
  label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  input {
    width: 100px;
    accent-color: var(--accent);
  }
  output,
  .model-message {
    font-size: 13px;
    color: var(--muted);
  }
  .model-message:not(:empty) {
    margin-top: 12px;
  }
</style>
