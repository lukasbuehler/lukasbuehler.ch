---
import { entryUrl, type Entry } from "../lib/entries";
import EntryDate from "./EntryDate.astro";
interface Props {
  entries: Entry[];
  projects?: boolean;
  headingLevel?: "h2" | "h3";
}
const { entries, projects = false, headingLevel: Heading = "h3" } = Astro.props;
---

<div class:list={["entry-list", { "project-list": projects }]}>
  {entries.map((entry) => (
    <a
      class:list={[
        "entry-link",
        { "entry-with-image": projects && !!entry.data.image },
      ]}
      href={entryUrl(entry)}
    >
      {projects && entry.data.image && (
        <img
          class="entry-thumbnail"
          src={entry.data.image.src}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="entry-heading">
        <Heading>{entry.data.title}</Heading>
        <div class="entry-details">
          {entry.data.kind === "note" && entry.data.published && (
            <EntryDate date={entry.data.published} />
          )}
          {entry.data.topics.length > 0 && (
            <span>{entry.data.topics.join(" / ")}</span>
          )}
        </div>
      </div>
      <div class="entry-summary">
        <p>{entry.data.description}</p>
        {entry.data.status && (
          <span class="entry-status">{entry.data.status}</span>
        )}
      </div>
    </a>
  ))}
</div>
